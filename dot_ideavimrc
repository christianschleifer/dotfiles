""" ALREADY SHIPPED WITH INTELLIJ
""" NERDTree is shipped with IntelliJ

""" INSTALL THE FOLLOWING PLUGINS
""" Which-Key
""" IdeaVim-EasyMotion
""" AceJump

""" Map leader to space ---------------------
let mapleader=" "

""" Common settings -------------------------
set showmode
set incsearch
set relativenumber

""" Idea specific settings ------------------
set ideajoin
set idearefactormode=keep

""" Plugins  --------------------------------
Plug 'terryma/vim-multiple-cursors'
nmap <C-n> <Plug>NextWholeOccurrence
xmap <C-n> <Plug>NextWholeOccurrence
nmap g<C-n> <Plug>NextOccurrence
xmap g<C-n> <Plug>NextOccurrence
nmap <C-x> <Plug>SkipOccurrence
xmap <C-x> <Plug>SkipOccurrence
nmap <C-p> <Plug>RemoveOccurrence
xmap <C-p> <Plug>RemoveOccurrence

""" which-key plugin
set which-key
set timeoutlen=10000

""" easymotion plugin
set easymotion
map s <Plug>(easymotion-s)

""" NERDTree plugin
set NERDTree
nnoremap <leader>e :NERDTreeFocus<CR>

""" Remapping ------------------------------
nmap gb <Action>(GotoImplementation)
nmap gn <Action>(ShowIntentionActions)
nmap gc <Action>(EditorCompleteStatement)
map <C-t> <Action>(Refactorings.QuickListPopupAction)

""" similar to open buffers in nvim
nnoremap <leader>, :action RecentFiles<CR>
""" similar to Snacks search in nvim
nnoremap <leader><leader> :action GotoFile<CR>

