[
  {
    "bindings": {
      "ctrl ctrl": "projects::OpenRecent"
    }
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "space e": "project_panel::ToggleFocus",
      "space ,": "tab_switcher::Toggle",
      "space space": "file_finder::Toggle",
      "space z": "workspace::ToggleEditorZoom"
    }
  },
  {
    "context": "TabSwitcher",
    "bindings": {
      ",": "tab_switcher::Toggle"
    }
  }
]
